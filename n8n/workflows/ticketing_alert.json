      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2880,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const jira = $json.jira_result;\nconst linear = $json.linear_result;\nconst results = [jira, linear].filter(Boolean);\nconst delivered = results.some((r) => r.delivered === true);\nconst errors = results.filter((r) => !r.delivered).map((r) => r.error).filter(Boolean);\nreturn [{ json: { channel: 'ticketing', delivered, error: delivered ? null : (errors.join('; ') || 'no_ticketing_system_enabled') } }];\n"
      }
