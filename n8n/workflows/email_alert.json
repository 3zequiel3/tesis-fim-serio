{
  "id": "9d42f98a-d16c-4224-9c9b-8c7a8593bff8",
  "name": "FIM - Email Alert",
  "active": true,
  "nodes": [
    {
      "id": "e95b7fd8-368f-41e1-b7d1-a27a14e3e756",
      "name": "When called by router",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "bbc4854f-80f7-45e9-a18b-343b4e271a26",
      "name": "Send alert email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        240,
        0
      ],
      "onError": "continueRegularOutput",
      "credentials": {
        "smtp": {
          "id": "n8n-fim-email-smtp",
          "name": "FIM Email SMTP"
        }
      },
      "parameters": {
        "fromEmail": "__FIM_ENV_N8N_EMAIL_FROM__",
        "toEmail": "__FIM_ENV_N8N_EMAIL_TO__",
        "subject": "=[FIM Alert] {{ ($json.payload.severity || 'notice').toUpperCase() }} \u2014 {{ $json.payload.path || $json.payload.component || 'n/a' }}",
        "emailFormat": "both",
        "html": "=<h2>FIM Platform Alert</h2><p style=\"font-size:16px;\"><strong>Severity:</strong> <span style=\"display:inline-block;padding:2px 10px;border-radius:4px;color:#ffffff;font-weight:bold;background-color:{{ ($json.payload.severity || '').toLowerCase() === 'critical' ? '#c0392b' : '#2980b9' }};\">{{ ($json.payload.severity || 'NOTICE').toUpperCase() }}</span></p><table border=\"1\" cellpadding=\"6\" cellspacing=\"0\" style=\"border-collapse:collapse;\"><tr><th align=\"left\">Field</th><th align=\"left\">Value</th></tr><tr><td>Path</td><td>{{ $json.payload.path || '' }}</td></tr><tr><td>Agent</td><td>{{ $json.payload.agent_id || '' }}</td></tr><tr><td>Status</td><td>{{ $json.payload.status || '' }}</td></tr><tr><td>Action Taken</td><td>{{ $json.payload.action_taken || '' }}</td></tr><tr><td>Detected At</td><td>{{ $json.payload.detected_at || '' }}</td></tr><tr><td>Notification ID</td><td>{{ $json.payload.notification_id || '' }}</td></tr><tr><td>Type</td><td>{{ $json.payload.type || '' }}</td></tr><tr><td>Event ID</td><td>{{ $json.payload.event_id || '' }}</td></tr><tr><td>Component</td><td>{{ $json.payload.component || '' }}</td></tr><tr><td>Old Status</td><td>{{ $json.payload.old_status || '' }}</td></tr><tr><td>New Status</td><td>{{ $json.payload.new_status || '' }}</td></tr></table>",
        "text": "=FIM Platform Alert\n\nSeverity: {{ ($json.payload.severity || 'notice').toUpperCase() }}\nPath: {{ $json.payload.path || '' }}\nAgent: {{ $json.payload.agent_id || '' }}\nStatus: {{ $json.payload.status || '' }}\nAction Taken: {{ $json.payload.action_taken || '' }}\nDetected At: {{ $json.payload.detected_at || '' }}\n\nNotification ID: {{ $json.payload.notification_id || '' }}\nType: {{ $json.payload.type || '' }}\nEvent ID: {{ $json.payload.event_id || '' }}\nComponent: {{ $json.payload.component || '' }}\nOld Status: {{ $json.payload.old_status || '' }}\nNew Status: {{ $json.payload.new_status || '' }}\n",
        "options": {
          "appendAttribution": false
        }
      }
    },
    {
      "id": "5f394e4b-4af6-43b3-96c0-38494c4860a5",
      "name": "Build email result",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        480,
        0
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "9e1f3829-25af-47e1-b5e1-d0f4de475593",
              "name": "channel",
              "type": "string",
              "value": "email"
            },
            {
              "id": "2e522cd8-4770-491b-bd64-82267f8eae71",
              "name": "delivered",
              "type": "boolean",
              "value": "={{ !$json.error }}"
            },
            {
              "id": "7ebe63f9-0999-4e53-9cb1-f5d2b38fcf8f",
              "name": "error",
              "type": "string",
              "value": "={{ $json.error ? String($json.error) : null }}"
            }
          ]
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "When called by router": {
      "main": [
        [
          {
            "node": "Send alert email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send alert email": {
      "main": [
        [
          {
            "node": "Build email result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "saveManualExecutions": true
  },
  "staticData": null,
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": true
  },
  "tags": []
}
