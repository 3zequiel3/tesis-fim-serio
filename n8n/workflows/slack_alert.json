{
  "id": "00100d40-0e73-4762-9b79-9a030f7b46f7",
  "name": "FIM - Slack Alert",
  "active": true,
  "nodes": [
    {
      "id": "58830492-3eeb-49c6-b8b0-d942b9b4fc86",
      "name": "When called by router",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "505906ea-11b4-41a4-a793-9ba1cca5c1e5",
      "name": "Load slack config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        0
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "5be640c3-6266-40cb-b1b3-fd1381e4f24c",
              "name": "slack_api_url",
              "type": "string",
              "value": "__FIM_ENV_N8N_SLACK_API_URL__"
            },
            {
              "id": "6d997187-0295-4201-bb2c-fedbb3101441",
              "name": "slack_channel",
              "type": "string",
              "value": "__FIM_ENV_N8N_SLACK_CHANNEL__"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "421cea4d-a4b6-450d-9e62-d8ea2f42e0aa",
      "name": "Post to Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "={{ $json.slack_api_url }}",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ channel: $json.slack_channel, text: `:rotating_light: FIM Alert | ${(($json.payload.severity)||'notice').toUpperCase()} | ${$json.payload.path || $json.payload.component || 'n/a'} | event_id=${$json.payload.event_id || 'n/a'} | status=${$json.payload.status || ''}` }) }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "slackApi"
      },
      "credentials": {
        "slackApi": {
          "id": "n8n-fim-slack-api",
          "name": "FIM Slack API"
        }
      }
    },
    {
      "id": "74f1ee59-c993-44c5-94cb-b3160568a884",
      "name": "Build slack result",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        720,
        0
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "fa54e713-cbbf-4bfe-bc13-64baa3ac31d5",
              "name": "channel",
              "type": "string",
              "value": "slack"
            },
            {
              "id": "84c55fc3-d066-421a-b121-16628f515692",
              "name": "delivered",
              "type": "boolean",
              "value": "={{ !$json.error && $json.statusCode >= 200 && $json.statusCode < 300 && $json.body?.ok === true }}"
            },
            {
              "id": "cf7ed385-772e-4a56-b476-6d4fabea260f",
              "name": "error",
              "type": "string",
              "value": "={{ $json.error ? String($json.error) : ($json.body && $json.body.ok === false ? ($json.body.error || 'slack_api_error') : ($json.statusCode >= 300 ? ('slack_http_error_' + $json.statusCode) : null)) }}"
            }
          ]
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "When called by router": {
      "main": [
        [
          {
            "node": "Load slack config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Load slack config": {
      "main": [
        [
          {
            "node": "Post to Slack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Post to Slack": {
      "main": [
        [
          {
            "node": "Build slack result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "saveManualExecutions": true
  },
  "staticData": null,
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": true
  },
  "tags": []
}
