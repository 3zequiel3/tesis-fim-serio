{
  "id": "5c01d9b8-702f-4de8-9672-7a515d62f10a",
  "name": "FIM - Controlled Alert Router",
  "active": false,
  "versionId": "729d4b36-e4b3-41b1-8da4-0429865b32f4",
  "nodes": [
    {
      "id": "15122c50-03dc-4e63-85e1-75f172610977",
      "name": "Receive FIM alert",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "fim-alert",
      "parameters": {
        "path": "fim-alert",
        "httpMethod": "POST",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "77cd89f0-6456-460d-b65b-e326a62c2737",
      "name": "Add acceptance timestamp",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [240, 0],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "5af0de60-ec44-4664-8425-b8191a676120",
              "name": "n8n_accepted_at",
              "type": "string",
              "value": "={{ $now.toISO() }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "194002d2-30a5-4935-8699-4686eec40f55",
      "name": "Deliver to controlled receiver",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 0],
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "http://controlled-receiver:8080/fim-alert",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ ...$json.body, n8n_accepted_at: $json.n8n_accepted_at }) }}",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "3d8742d2-b9b4-4d48-8329-b5e86daadd1d",
      "name": "Confirm durable receipt",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [760, 0],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { accepted: !$json.error && $json.statusCode >= 200 && $json.statusCode < 300, notification_id: $json.body?.notification_id || null, receiver_received_at: $json.body?.receiver_received_at || null, error: $json.error ? 'controlled_receiver_unavailable' : (($json.statusCode >= 200 && $json.statusCode < 300) ? null : 'controlled_receiver_rejected') } }}",
        "options": {
          "responseCode": "={{ (!$json.error && $json.statusCode >= 200 && $json.statusCode < 300) ? 202 : 502 }}"
        }
      }
    }
  ],
  "connections": {
    "Receive FIM alert": {
      "main": [[{"node": "Add acceptance timestamp", "type": "main", "index": 0}]]
    },
    "Add acceptance timestamp": {
      "main": [[{"node": "Deliver to controlled receiver", "type": "main", "index": 0}]]
    },
    "Deliver to controlled receiver": {
      "main": [[{"node": "Confirm durable receipt", "type": "main", "index": 0}]]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "saveManualExecutions": true
  },
  "staticData": null,
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": true
  },
  "tags": []
}
