.env

.venv
backend/__pycache__/
backend/.pytest_cache/
backend/.mypy_cache/
backend/.coverage
backend/coverage.xml
backend/htmlcov/
backend/.vscode/
.agent
.opencode
.vscode
.agents

# Claude Code: configuración compartida (.claude/settings.json, agents/,
# commands/, skills/) SÍ se versiona. settings.local.json es per-user.
.claude/settings.local.json

# Frontend
node_modules/
frontend/dist/
frontend/coverage/
frontend/.env.development
frontend/.env.local
frontend/.env.*.local

# Cache
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/*.so
*.egg-info/

skills-lock.json
.atl/

# Contenedor de test del agente: contenido de runtime del dir vigilado (se
# mantiene el .gitkeep para que el bind mount exista) y artefactos de Playwright.
/fim-watch/*
!/fim-watch/.gitkeep
/.playwright-mcp/
/fim-0*.png
# Artefactos de corridas de medicion (Cap. 5). Los de la corrida oficial
# se archivan deliberadamente junto a las planillas (Anexo F), no por git add.
tesis/resultados/
resultados/

# Certificado provisto del operador para la consola (CONSOLE_TLS_DIR,
# D55/RN-149, change 52) — nunca commitear material TLS real.
/deploy/console-tls/*
!/deploy/console-tls/.gitkeep

# Artefactos locales de laboratorio y de cierre todavía no consolidados.
# El paquete del ensayo A-3 (a3-multihost/) sí se versiona.
/.env.lab-backup
/fim-ca.pem
/tesis/cierre/AUDITORIA_INTEGRAL_TESIS_V*
/tesis/cierre/REGISTRO_CAMBIOS_TESIS_V*.md
/tesis/cierre/Tesis_v*_cierre_tecnico*.docx
/tesis/cierre/Tesis_v*_cierre_tecnico*.pdf
/tesis/cierre/evidencia/a4-vps-*/
# Los paquetes que la tesis cita como origen de sus resultados se versionan: sin
# ellos, quien clona el repositorio no puede verificar lo que el documento afirma
# sobre los candidatos 7df4935 y 7a7ee50. El resto de las corridas de esa serie
# —dos intentos que no completaron, uno de ellos abortado con el árbol de trabajo
# sucio, y una consolidación previa que las posteriores superan— queda fuera y
# declarado en el Anexo F.
#
# `final-consolidated-fixed-20260911T225314Z` entra por la misma razón que las
# otras dos: la tesis lo cita en §4.9, en la Tabla 12, en el Anexo F.1 y en la
# Tabla 37, y un paquete citado que no se puede abrir no sustenta nada. Ocupa
# 8,7 MB, ningún archivo suyo supera los 2,1 MB y su manifiesto verifica 292 de
# 292.
/tesis/cierre/evidencia/experiments-closure-*/
!/tesis/cierre/evidencia/experiments-closure-20260912T004612Z/
/tesis/cierre/evidencia/final-consolidated-*/
!/tesis/cierre/evidencia/final-consolidated-v10-20260912T210903Z/
!/tesis/cierre/evidencia/final-consolidated-fixed-20260911T225314Z/
/tesis/cierre/evidencia/us02-us20-us31-*/
/tesis/cierre/evidencia/us03-us16-us17-us25-isolated-*/
/tesis/cierre/evidencia/us03-us25-playwright-*/
/tesis/cierre/evidencia/v10-closure-20260912T190052Z/*
!/tesis/cierre/evidencia/v10-closure-20260912T190052Z/a3-multihost/
