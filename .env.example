# =============================================================================
# .env.example — FIM Platform
#
# Copiá este archivo a .env y completá los valores antes del primer arranque:
#   cp .env.example .env
#
# El archivo .env NUNCA se commitea (está en .gitignore).
# Este .env.example SÍ se versiona: documenta el contrato de configuración.
#
# Cada variable indica en qué change empieza a consumirse activamente.
# En este change (infra-docker-compose) solo DB_PASSWORD es leído por
# servicios que realmente corren (db y n8n). Las demás están declaradas
# para que `docker compose config` valide en seco y para evitar drift.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------

# Contraseña del usuario aplicativo `fim` en PostgreSQL.
# Usada por: servicio db (POSTGRES_PASSWORD), n8n (DB_POSTGRESDB_PASSWORD),
#            backend (DATABASE_URL) cuando exista en Change 02.
# Formato: string arbitrario, mín. 16 chars. No usar caracteres especiales
#          que rompan la URL de conexión (@, /, #, :) sin encodear.
# Generación sugerida: openssl rand -base64 24
# IMPORTANTE: rotar DB_PASSWORD después del primer arranque requiere ejecutar
#   ALTER USER fim WITH PASSWORD 'nueva_password';
# en psql — la imagen de PostgreSQL NO re-ejecuta los scripts de init ni
# actualiza la password automáticamente cuando cambia esta variable.
# Change que la consume: 01 (infra-docker-compose) — ya activa.
DB_PASSWORD=

# -----------------------------------------------------------------------------
# JWT (autenticación del backend)
# -----------------------------------------------------------------------------

# Secret actual para firmar tokens JWT (algoritmo HS256).
# Formato: string hexadecimal, mín. 32 bytes (64 chars hex).
# Generación: openssl rand -hex 32
# En producción rotarlo periódicamente: mover el valor actual a
# JWT_SECRET_PREVIOUS y generar uno nuevo aquí.
# Change que lo consume: 02 (backend-core-scaffold).
JWT_SECRET_CURRENT=

# Secret previo durante rotación de JWT.
# Permite que tokens emitidos con el secret anterior sigan siendo válidos
# durante la ventana de rotación (hasta que todos expiren).
# En el primer deploy puede dejarse vacío — no hay tokens previos.
# Change que lo consume: 02 (backend-core-scaffold).
JWT_SECRET_PREVIOUS=

# -----------------------------------------------------------------------------
# Admin inicial del backend
# -----------------------------------------------------------------------------

# Username del primer usuario administrador.
# El lifespan de FastAPI (Change 02) ejecuta seed_admin() que crea este
# usuario si no existe. Idempotente: no falla si ya existe (D3).
# Change que lo consume: 02 (backend-core-scaffold).
ADMIN_USERNAME=admin

# Contraseña inicial del primer admin.
# El sistema forzará al usuario a cambiarla en el primer login (HU auth M1).
# Generación: openssl rand -base64 16
# Change que lo consume: 02 (backend-core-scaffold).
ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Certificados mTLS para agentes (RN-78)
# -----------------------------------------------------------------------------

# Path DENTRO del contenedor backend al certificado de la CA propia.
# El volumen backend_certs se monta en /certs; Change 04 (agent-mtls-ca)
# emite la CA y la deposita en ese volumen.
# No modificar estos paths salvo que Change 04 lo indique explícitamente.
# Change que lo consume: 04 (agent-mtls-ca).
CA_CERT_PATH=/certs/ca.pem

# Path DENTRO del contenedor backend a la clave privada de la CA propia.
# Mismas condiciones que CA_CERT_PATH.
# Change que lo consume: 04 (agent-mtls-ca).
CA_KEY_PATH=/certs/ca-key.pem

# Certificado del propio backend para el listener mTLS en puerto 8443.
# ensure_ca() lo genera automáticamente al primer arranque si no existe.
# Change que lo consume: 06 (agent-mtls-bootstrap).
BACKEND_CERT_PATH=/certs/backend.pem

# Clave privada del backend para mTLS.
# Change que lo consume: 06 (agent-mtls-bootstrap).
BACKEND_KEY_PATH=/certs/backend-key.pem

# -----------------------------------------------------------------------------
# Rate limit de ingesta de eventos (RN-88)
# -----------------------------------------------------------------------------

# Presupuesto de eventos por ventana deslizante y por agent_id en el consumer
# del stream `events`. Los defaults son el comportamiento histórico y de
# producción; se suben SOLO para las baterías de carga del Cap. 5 (P1 del plan
# de medición), donde un techo de 100/60 s estrangula la propia medición.
# También determina el `retry_after` del `event_nack` de rate_limited
# (D37/RN-131): el agente reintenta cuando se libera cupo en esta ventana.
# Change que lo consume: 11 (backend-event-ingestion).
RATE_LIMIT_INGEST_EVENTS=100

# Ventana deslizante en segundos para el presupuesto anterior. Acepta decimales.
RATE_LIMIT_INGEST_WINDOW_SECONDS=60
