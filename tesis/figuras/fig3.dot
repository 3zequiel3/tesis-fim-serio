digraph G {
  graph [fontname="DejaVu Sans" fontsize=15 dpi=300 pad=0.2 nodesep=0.5 ranksep=0.6 bgcolor=white];
  node  [fontname="DejaVu Sans" fontsize=14];
  edge  [fontname="DejaVu Sans" fontsize=12 color="#333333" fontcolor="#222222" arrowsize=0.8];
  rankdir=TB; newrank=true; nodesep=0.35; ranksep=0.28;
subgraph cluster_f1 { label=<<B>Fase 1 · Arranque</B>> style="rounded,filled" fillcolor="#F7F8FA" color="#9AA3AD" margin=14;
a1 [shape=box style="rounded,filled" fillcolor="white" color="#5B7DB1" label=<Leer configuración local<BR/><FONT POINT-SIZE="11">env vars, /etc/fim-agent</FONT>> width=3.6];
a2 [shape=box style="rounded,filled" fillcolor="white" color="#5B7DB1" label=<Cargar secreto maestro<BR/><FONT POINT-SIZE="11">archivo con permisos restrictivos</FONT>> width=3.6];
a3 [shape=box style="rounded,filled" fillcolor="white" color="#5B7DB1" label=<Derivar clave de la baseline<BR/><FONT POINT-SIZE="11">HKDF-SHA256</FONT>> width=3.6];
a4 [shape=box style="rounded,filled" fillcolor="white" color="#5B7DB1" label=<Abrir la baseline cifrada<BR/><FONT POINT-SIZE="11">AES-256-GCM, autenticada en disco</FONT>> width=3.6];
a5 [shape=box style="rounded,filled" fillcolor="white" color="#5B7DB1" label=<Rehidratar el journal<BR/><FONT POINT-SIZE="11">acciones previas pendientes o en ejecución</FONT>> width=3.6];
a6 [shape=box style="rounded,filled" fillcolor="white" color="#5B7DB1" label=<Verificar el certificado TLS<BR/><FONT POINT-SIZE="11">rotar si vence en menos de 15 días</FONT>> width=3.6];
a7 [shape=box style="rounded,filled" fillcolor="white" color="#5B7DB1" label=<Establecer mTLS con el backend<BR/><FONT POINT-SIZE="11">TLS 1.3 · CA propia</FONT>> width=3.6];
a8 [shape=box style="rounded,filled" fillcolor="white" color="#5B7DB1" label=<Consumir el stream commands<BR/><FONT POINT-SIZE="11">configuración y nueva versión de reglas</FONT>> width=3.6];
a9 [shape=box style="rounded,filled" fillcolor="#FFF6D6" color="#C9A227" label=<Reconciliar la baseline con el disco<BR/><FONT POINT-SIZE="11">modificados, borrados y creados con el agente detenido;<BR/>eventos con detected_offline (Change 62)</FONT>> width=3.6];
a10 [shape=box style="rounded,filled" fillcolor="white" color="#5B7DB1" label=<Drenar la cola local en orden FIFO> width=3.6];
a11 [shape=box style="rounded,filled" fillcolor="white" color="#5B7DB1" label=<Configurar fanotify<BR/><FONT POINT-SIZE="11">FAN_CLASS_NOTIF · FAN_REPORT_DFID_NAME<BR/>FAN_MARK_FILESYSTEM · filtrado del alcance en espacio de usuario</FONT>> width=3.6];
a12 [shape=box style="rounded,filled" fillcolor="#E6E9ED" color="#6C757D" label=<<B>Transición a operación</B>> width=3.6];
a1 -> a2 -> a3 -> a4 -> a5 -> a6 -> a7 -> a8 -> a9 -> a10 -> a11 -> a12;
}
subgraph cluster_f2 { label=<<B>Fase 2 · Operación continua</B>> style="rounded,filled" fillcolor="#F7F8FA" color="#9AA3AD" margin=14;
b1 [shape=box style="rounded,filled" fillcolor="white" color="#5B7DB1" label=<<B>Leer evento de fanotify</B><BR/><FONT POINT-SIZE="11">máscara · FID del directorio padre + nombre · PID</FONT>> width=3.6];
b2 [shape=box style="rounded,filled" fillcolor="white" color="#5B7DB1" label=<Resolver la ruta (open_by_handle_at)<BR/><FONT POINT-SIZE="11">UID y ejecutable vía /proc/&lt;pid&gt;, de mejor esfuerzo</FONT>> width=3.6];
b3 [shape=box style="rounded,filled" fillcolor="white" color="#5B7DB1" label=<Estampar detected_at y encolar para procesamiento> width=3.6];
b4 [shape=box style="rounded,filled" fillcolor="white" color="#5B7DB1" label=<Calcular SHA-256 del archivo> width=3.6];
b5 [shape=diamond style=filled fillcolor="white" color="#5B7DB1" label="¿El hash coincide\ncon la baseline?" fontsize=12];
b6 [shape=box style="rounded,filled" fillcolor="#F1F3F5" color="#6C757D" label=<Descartar sin publicar<BR/><FONT POINT-SIZE="11">traza: matches_active_baseline</FONT>> width=3.6];
b7 [shape=box style="rounded,filled" fillcolor="white" color="#5B7DB1" label=<Evaluar reglas cacheadas> width=3.6];
b8 [shape=box style="rounded,filled" fillcolor="white" color="#5B7DB1" label=<<B>Escribir el journal: pendiente</B><BR/><FONT POINT-SIZE="11">antes de ejecutar la acción (write-ahead)</FONT>> width=3.6];
b9 [shape=box style="rounded,filled" fillcolor="white" color="#5B7DB1" label=<<B>Ejecutar la acción (4 niveles)</B><BR/><FONT POINT-SIZE="11">auto_restore · quarantine · manual_review · alert_only</FONT>> width=3.6];
b10 [shape=box style="rounded,filled" fillcolor="white" color="#5B7DB1" label=<<B>Publicar en el stream events</B><BR/><FONT POINT-SIZE="11">UUID · ruta · hashes · detected_at;<BR/>al publicar se agregan sent_at y la firma HMAC</FONT>> width=3.6];
b11 [shape=box style="rounded,dashed,filled" fillcolor="white" color="#6C757D" label=<Si la publicación falla<BR/><FONT POINT-SIZE="11">el evento queda en /var/lib/fim-agent/queue/ (≤ 100 MB)<BR/>y se republica en orden FIFO estricto</FONT>> width=3.6];
ov [shape=box style="rounded,filled" fillcolor="#FDECEC" color="#B85450" label=<<B>FAN_Q_OVERFLOW</B><BR/><FONT POINT-SIZE="11">evento detection_gap<BR/>(como máximo uno cada 60 s)</FONT>> width=3.6];
b1->b2->b3->b4->b5; b5->b6 [label=" sí"]; b5->b7 [label=" no"]; b7->b8->b9->b10->b11; b11->b1 [constraint=false label=" siguiente evento" style=dashed]; b1->ov [style=dashed]; {rank=same; b1; ov;} {rank=same; b6; b7;}
}
subgraph cluster_f3 { label=<<B>Fase 3 · Sincronización (concurrente con la Fase 2)</B>> style="rounded,filled" fillcolor="#F7F8FA" color="#9AA3AD" margin=14;
c1 [shape=box style="rounded,filled" fillcolor="white" color="#5B7DB1" label=<<B>Latido cada 10 s</B><BR/><FONT POINT-SIZE="11">stream agent_heartbeat · tamaño de cola<BR/>queue_pressure · queue_pressure_high · ruleset_version</FONT>> width=3.6];
c2 [shape=box style="rounded,filled" fillcolor="white" color="#5B7DB1" label=<<B>Consumir comandos</B><BR/><FONT POINT-SIZE="11">verificar HMAC; descartar versión ≤ última aplicada</FONT>> width=3.6];
c3 [shape=box style="rounded,filled" fillcolor="white" color="#5B7DB1" label=<<B>Consumir event_ack</B><BR/><FONT POINT-SIZE="11">eliminar la entrada local correspondiente</FONT>> width=3.6];
c4 [shape=box style="rounded,filled" fillcolor="#FFF6D6" color="#C9A227" label=<<B>Republicación FIFO estricta</B><BR/><FONT POINT-SIZE="11">sondeo cada 0,5 s; la pasada se corta ante el primer error;<BR/>la rehidratación va detrás de lo pendiente (Change 61)</FONT>> width=3.6];
c5 [shape=box style="rounded,filled" fillcolor="white" color="#5B7DB1" label=<<B>Rotación del certificado</B><BR/><FONT POINT-SIZE="11">desde 15 días antes del vencimiento, sobre mTLS vigente</FONT>> width=3.6];
c6 [shape=box style="rounded,filled" fillcolor="white" color="#5B7DB1" label=<<B>Señal SIGTERM</B><BR/><FONT POINT-SIZE="11">deja de aceptar eventos · drena la cola (≤ 30 s)<BR/>latido con bandera shutdown · exit 0</FONT>> width=3.6];
c1 -> c2 -> c3 -> c4 -> c5 -> c6 [style=invis];
}
{rank=same; a1; b1; c1;}
label="Los recuadros amarillos señalan los pasos incorporados por las Changes 61 y 62."; labelloc=b; fontsize=12;
}