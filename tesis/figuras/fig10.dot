digraph G {
  graph [fontname="DejaVu Sans" fontsize=16 dpi=300 pad=0.2 bgcolor=white];
  node  [fontname="DejaVu Sans" fontsize=15];
  edge  [fontname="DejaVu Sans" fontsize=13 color="#333333" fontcolor="#222222" arrowsize=0.8];
  rankdir=TB; compound=true; nodesep=0.25; ranksep=0.4;
 
  subgraph cluster_ag {
    label=<<FONT POINT-SIZE="13">«subsystem»</FONT><BR/><B>Agente FIM · anfitrión monitoreado</B>>;
    style="rounded,filled"; fillcolor="#F7F8FA"; color="#5B7DB1"; margin=12;
    node [shape=component style=filled fillcolor="#EAF1FB" color="#5B7DB1"];
    rec [label=<<B>Recuperador</B><BR/><FONT POINT-SIZE="13">rehidratación y<BR/>reconciliación al arrancar</FONT>>];
    obs [label=<<B>Observador</B><BR/><FONT POINT-SIZE="13">fanotify</FONT>>];
    hsh [label=<<B>Calculador de huellas</B><BR/><FONT POINT-SIZE="13">SHA-256</FONT>>];
    sto [label=<<B>Almacenamiento local</B><BR/><FONT POINT-SIZE="13">línea base cifrada · cola<BR/>cuarentena · journal</FONT>>];
    dec [label=<<B>Motor de decisión</B><BR/><FONT POINT-SIZE="13">reglas locales<BR/>4 acciones</FONT>>];
    com [label=<<B>Comunicador</B><BR/><FONT POINT-SIZE="13">Valkey · HMAC<BR/>FIFO estricto</FONT>>];
    {rank=same; rec; obs;}
    {rank=same; sto; hsh;}
    {rank=same; com; dec;}
    rec -> obs [label=" instala marcas"];
    obs -> hsh; hsh -> dec; hsh -> sto [dir=both]; dec -> sto [dir=both];
    dec -> com; com -> sto; rec -> sto;
  }
 
  valkey [shape=box style="rounded,filled" fillcolor="#FFF6D6" color="#C9A227"
          label=<<FONT POINT-SIZE="13">«infrastructure»</FONT><BR/><B>Valkey Streams</B><BR/><FONT POINT-SIZE="13">TLS con certificado<BR/>de cliente · AOF</FONT>>];
 
  subgraph cluster_be {
    label=<<FONT POINT-SIZE="13">«subsystem»</FONT><BR/><B>Backend · 8 módulos de dominio y núcleo transversal</B>>;
    style="rounded,filled"; fillcolor="#F7F8FA"; color="#6F5BA7"; margin=12;
    node [shape=component style=filled fillcolor="#F1ECFA" color="#6F5BA7"];
    rul  [label=<<B>reglas</B><BR/><FONT POINT-SIZE="13">sync ·<BR/>despacho de comandos</FONT>>];
    evs  [label=<<B>eventos</B><BR/><FONT POINT-SIZE="13">consumidor por lote</FONT>>];
    agt  [label=<<B>agentes</B><BR/><FONT POINT-SIZE="13">registro ·<BR/>secreto cifrado</FONT>>];
    act  [label=<<B>acciones</B><BR/><FONT POINT-SIZE="13">cuarentena<BR/>y liberación</FONT>>];
    alr  [label=<<B>alertas</B><BR/><FONT POINT-SIZE="13">incluye la<BR/>notificación</FONT>>];
    aud  [label=<<B>auditoría</B>>];
    auth [label=<<B>autenticación</B>>];
    core [label=<<B>núcleo transversal</B><BR/><FONT POINT-SIZE="13">salud · migraciones<BR/>límite de ingesta</FONT>>];
    usr  [label=<<B>usuarios</B>>];
    {rank=same; rul; evs; agt;}
    {rank=same; act; alr; aud;}
    {rank=same; auth; core; usr;}
    rul -> evs -> agt [style=invis]; act -> alr -> aud [style=invis]; auth -> core -> usr [style=invis];
    evs -> alr -> core [style=invis]; agt -> aud -> usr [style=invis]; rul -> act -> auth [style=invis];
    act -> rul [style=dashed label=" encola\n comandos"];
  }
 
  pg [shape=cylinder style=filled fillcolor="#E6F4EA" color="#4A8F5A" label=<<B>PostgreSQL</B>>];
 
  subgraph cluster_fe {
    label=<<FONT POINT-SIZE="13">«subsystem»</FONT><BR/><B>Frontend · React/Vite</B>>;
    style="rounded,filled"; fillcolor="#F7F8FA"; color="#4A8F5A"; margin=12;
    node [shape=component style=filled fillcolor="#E6F4EA" color="#4A8F5A"];
    pages  [label=<<B>pages</B><BR/><FONT POINT-SIZE="13">vistas</FONT>>];
    stores [label=<<B>stores</B><BR/><FONT POINT-SIZE="13">Zustand</FONT>>];
    cmps   [label=<<B>components</B><BR/><FONT POINT-SIZE="13">layout + UI</FONT>>];
    api    [label=<<B>api</B><BR/><FONT POINT-SIZE="13">cliente HTTP</FONT>>];
    {rank=same; pages; stores;}
    {rank=same; cmps; api;}
    pages -> stores; pages -> cmps; stores -> api;
  }
 
  com -> valkey [weight=8 dir=both label=" eventos ↓\n ↑ comandos" color="#A07D10" fontcolor="#7A5C00"];
  valkey -> evs [weight=8 label=" consume\n eventos" color="#5B7DB1" fontcolor="#2F4F7F"];
  valkey -> rul [dir=back label=" publica comandos\n tras confirmar" color="#5B7DB1" fontcolor="#2F4F7F"];
  com -> agt [dir=both weight=0 label=" agente ↔ backend:\n TLS 1.3 + mTLS"];
  core -> pg [dir=both];
  api -> usr [dir=both lhead=cluster_be label=" HTTP / SSE (API)"];
  auth -> pages [style=invis];
}
