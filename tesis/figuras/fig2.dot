digraph G {
  graph [fontname="DejaVu Sans" fontsize=15 dpi=300 pad=0.2 nodesep=0.5 ranksep=0.6 bgcolor=white];
  node  [fontname="DejaVu Sans" fontsize=14];
  edge  [fontname="DejaVu Sans" fontsize=12 color="#333333" fontcolor="#222222" arrowsize=0.8];
  rankdir=TB; nodesep=0.45; ranksep=0.7; splines=polyline;
agents [shape=plain label=<<TABLE BORDER="1" COLOR="#5B7DB1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" STYLE="ROUNDED"><TR><TD BGCOLOR="#EAF1FB"><B>agents</B></TD></TR><TR><TD BGCOLOR="white"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>PK</B> agent_id</TD></TR><TR><TD ALIGN="LEFT">status · registered_at</TD></TR><TR><TD ALIGN="LEFT">last_heartbeat · ruleset_version_applied</TD></TR><TR><TD ALIGN="LEFT">queue_pressure · queue_size</TD></TR><TR><TD ALIGN="LEFT">bootstrap_secret_hash · shared_secret_hex</TD></TR><TR><TD ALIGN="LEFT">watch_paths (JSON)</TD></TR><TR><TD ALIGN="LEFT">watch_path_status · discarded_events</TD></TR><TR><TD ALIGN="LEFT">out_of_scope_drops · queue_pressure_high</TD></TR></TABLE></TD></TR></TABLE>>];
revoked_certificates [shape=plain label=<<TABLE BORDER="1" COLOR="#5B7DB1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" STYLE="ROUNDED"><TR><TD BGCOLOR="#EAF1FB"><B>revoked_certificates</B></TD></TR><TR><TD BGCOLOR="white"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>PK</B> id</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> agent_id → agents.agent_id</TD></TR><TR><TD ALIGN="LEFT">serial_number · revoked_at</TD></TR><TR><TD ALIGN="LEFT">reason</TD></TR></TABLE></TD></TR></TABLE>>];
baseline_entries [shape=plain label=<<TABLE BORDER="1" COLOR="#5B7DB1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" STYLE="ROUNDED"><TR><TD BGCOLOR="#EAF1FB"><B>baseline_entries</B></TD></TR><TR><TD BGCOLOR="white"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>PK</B> id</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> agent_id → agents.agent_id</TD></TR><TR><TD ALIGN="LEFT">path · hash</TD></TR><TR><TD ALIGN="LEFT">status · last_updated</TD></TR><TR><TD ALIGN="LEFT">ruleset_version</TD></TR></TABLE></TD></TR></TABLE>>];
alerts [shape=plain label=<<TABLE BORDER="1" COLOR="#5B7DB1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" STYLE="ROUNDED"><TR><TD BGCOLOR="#EAF1FB"><B>alerts</B></TD></TR><TR><TD BGCOLOR="white"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>PK</B> id</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> event_id → events.id</TD></TR><TR><TD ALIGN="LEFT">severity · channel</TD></TR><TR><TD ALIGN="LEFT">delivered_at · channel_accepted_at</TD></TR><TR><TD ALIGN="LEFT">failed_at · last_error</TD></TR><TR><TD ALIGN="LEFT">retry_count</TD></TR><TR><TD ALIGN="LEFT">notification_id (UNIQUE)</TD></TR><TR><TD ALIGN="LEFT">attempt_count · next_retry_at</TD></TR><TR><TD ALIGN="LEFT">created_at</TD></TR></TABLE></TD></TR></TABLE>>];
audit_log [shape=plain label=<<TABLE BORDER="1" COLOR="#5B7DB1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" STYLE="ROUNDED"><TR><TD BGCOLOR="#EAF1FB"><B>audit_log</B></TD></TR><TR><TD BGCOLOR="white"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>PK</B> id</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> user_id → users.id</TD></TR><TR><TD ALIGN="LEFT">action · target_type</TD></TR><TR><TD ALIGN="LEFT">target_id · detail</TD></TR><TR><TD ALIGN="LEFT">created_at</TD></TR></TABLE></TD></TR></TABLE>>];
users [shape=plain label=<<TABLE BORDER="1" COLOR="#5B7DB1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" STYLE="ROUNDED"><TR><TD BGCOLOR="#EAF1FB"><B>users</B></TD></TR><TR><TD BGCOLOR="white"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>PK</B> id</TD></TR><TR><TD ALIGN="LEFT">username (UNIQUE)</TD></TR><TR><TD ALIGN="LEFT">email (UNIQUE)</TD></TR><TR><TD ALIGN="LEFT">password_hash (Argon2id)</TD></TR><TR><TD ALIGN="LEFT">role · is_active</TD></TR><TR><TD ALIGN="LEFT">must_change_password · created_at</TD></TR></TABLE></TD></TR></TABLE>>];
rules [shape=plain label=<<TABLE BORDER="1" COLOR="#6C757D" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" STYLE="ROUNDED"><TR><TD BGCOLOR="#F1F3F5"><B>rules</B></TD></TR><TR><TD BGCOLOR="white"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>PK</B> id</TD></TR><TR><TD ALIGN="LEFT">pattern · severity</TD></TR><TR><TD ALIGN="LEFT">action · created_at</TD></TR><TR><TD ALIGN="LEFT">updated_at</TD></TR></TABLE></TD></TR></TABLE>>];
ruleset_versions [shape=plain label=<<TABLE BORDER="1" COLOR="#6C757D" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" STYLE="ROUNDED"><TR><TD BGCOLOR="#F1F3F5"><B>ruleset_versions</B></TD></TR><TR><TD BGCOLOR="white"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>PK</B> id</TD></TR><TR><TD ALIGN="LEFT">version · updated_at</TD></TR></TABLE></TD></TR></TABLE>>];
published_commands [shape=plain label=<<TABLE BORDER="1" COLOR="#6C757D" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" STYLE="ROUNDED"><TR><TD BGCOLOR="#F1F3F5"><B>published_commands</B></TD></TR><TR><TD BGCOLOR="white"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>PK</B> id</TD></TR><TR><TD ALIGN="LEFT">command_type</TD></TR><TR><TD ALIGN="LEFT">target_agent_id (sin FK)</TD></TR><TR><TD ALIGN="LEFT">event_id (sin FK)</TD></TR><TR><TD ALIGN="LEFT">ruleset_version · payload</TD></TR><TR><TD ALIGN="LEFT">status (outbox)</TD></TR><TR><TD ALIGN="LEFT">published_at</TD></TR><TR><TD ALIGN="LEFT">command_id (UNIQUE)</TD></TR><TR><TD ALIGN="LEFT">ack_status · acked_at</TD></TR><TR><TD ALIGN="LEFT">error</TD></TR></TABLE></TD></TR></TABLE>>];
events [shape=plain label=<<TABLE BORDER="1" COLOR="#5B7DB1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" STYLE="ROUNDED"><TR><TD BGCOLOR="#EAF1FB"><B>events</B></TD></TR><TR><TD BGCOLOR="white"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>PK</B> id</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> agent_id → agents.agent_id</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> parent_event_id → events.id</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> resolved_by → users.id</TD></TR><TR><TD ALIGN="LEFT">event_id (UUID v4 del agente, UNIQUE)</TD></TR><TR><TD ALIGN="LEFT">event_type</TD></TR><TR><TD ALIGN="LEFT">path (NULL en detection_gap)</TD></TR><TR><TD ALIGN="LEFT">hash_detected · hash_expected</TD></TR><TR><TD ALIGN="LEFT">diff_text · is_binary</TD></TR><TR><TD ALIGN="LEFT">hex_dump_before · hex_dump_after</TD></TR><TR><TD ALIGN="LEFT">status · severity</TD></TR><TR><TD ALIGN="LEFT">is_symlink · symlink_target</TD></TR><TR><TD ALIGN="LEFT">action_failed · action_error</TD></TR><TR><TD ALIGN="LEFT">detected_offline (Change 62)</TD></TR><TR><TD ALIGN="LEFT">version (bloqueo optimista)</TD></TR><TR><TD ALIGN="LEFT">process_pid · process_uid</TD></TR><TR><TD ALIGN="LEFT">process_exe · detected_at</TD></TR><TR><TD ALIGN="LEFT">received_at · created_at</TD></TR><TR><TD ALIGN="LEFT">resolved_at</TD></TR></TABLE></TD></TR></TABLE>>];
rejected_events_audit [shape=plain label=<<TABLE BORDER="1" COLOR="#6C757D" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" STYLE="ROUNDED"><TR><TD BGCOLOR="#F1F3F5"><B>rejected_events_audit</B></TD></TR><TR><TD BGCOLOR="white"><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B>PK</B> id</TD></TR><TR><TD ALIGN="LEFT">event_id (sin FK)</TD></TR><TR><TD ALIGN="LEFT">agent_id · reason</TD></TR><TR><TD ALIGN="LEFT">received_at · detected_at</TD></TR><TR><TD ALIGN="LEFT">payload_dump</TD></TR></TABLE></TD></TR></TABLE>>];
users -> audit_log [arrowhead=none xlabel="user_id" headlabel="N" taillabel="1" labeldistance=1.6 fontsize=12];
users -> events [arrowhead=none xlabel="resolved_by" headlabel="0..N" taillabel="1" labeldistance=1.6 fontsize=12];
agents -> events [arrowhead=none xlabel="agent_id" headlabel="N" taillabel="1" labeldistance=1.6 fontsize=12];
agents -> baseline_entries [arrowhead=none xlabel="agent_id" headlabel="N" taillabel="1" labeldistance=1.6 fontsize=12];
agents -> revoked_certificates [arrowhead=none xlabel="agent_id" headlabel="N" taillabel="1" labeldistance=1.6 fontsize=12];
events -> alerts [arrowhead=none xlabel="event_id" headlabel="N" taillabel="1" labeldistance=1.6 fontsize=12];
events:e -> events:e [arrowhead=none label="parent_event_id (1:N)" fontsize=12];
{rank=same; users; agents;}
{rank=same; audit_log; events; baseline_entries; revoked_certificates;}
{rank=same; alerts; rejected_events_audit; published_commands; ruleset_versions; rules;}
ruleset_versions -> published_commands [style=invis]; ruleset_versions -> rejected_events_audit [style=invis];
}